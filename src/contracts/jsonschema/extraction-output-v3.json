{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regulagraph.local/schema/extraction-output-v3.json",
  "title": "Experimental extraction v3: indexed source ranges",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mentions",
    "assertions",
    "supports"
  ],
  "properties": {
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mention"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "supports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/support"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_id",
        "candidate_type",
        "span"
      ],
      "properties": {
        "local_id": {
          "$ref": "#/$defs/localId"
        },
        "candidate_type": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/$defs/indexedSpan"
        }
      }
    },
    "qualifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_id",
        "value_kind",
        "value"
      ],
      "properties": {
        "predicate_id": {
          "type": "string",
          "minLength": 1
        },
        "value_kind": {
          "enum": [
            "mention",
            "literal",
            "date",
            "number"
          ]
        },
        "value": {}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_id",
        "subject_local_id",
        "predicate_id",
        "object_local_id",
        "origin",
        "qualifiers",
        "exception_local_ids"
      ],
      "properties": {
        "local_id": {
          "$ref": "#/$defs/localId"
        },
        "subject_local_id": {
          "$ref": "#/$defs/localId"
        },
        "predicate_id": {
          "type": "string",
          "minLength": 1
        },
        "object_local_id": {
          "$ref": "#/$defs/localId"
        },
        "origin": {
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualifier"
          }
        },
        "exception_local_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localId"
          },
          "uniqueItems": true
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_local_id",
        "spans"
      ],
      "properties": {
        "assertion_local_id": {
          "$ref": "#/$defs/localId"
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/indexedSpan"
          }
        }
      }
    },
    "indexedSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_token",
        "last_token"
      ],
      "properties": {
        "first_token": {
          "type": "integer",
          "minimum": 1
        },
        "last_token": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "description": "Provider selects inclusive first_token/last_token IDs from the indexed source. The gateway derives exact source text and byte offsets before C01 projection. No model-written quotes, byte offsets, fuzzy matching, or canonical assignment."
}
