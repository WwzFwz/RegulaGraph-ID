' Architecture source for README; render locally to SVG with PlantUML.
' Shows component ownership and chronological ingestion/query; planned routing is labelled.
@startuml
skinparam linetype ortho
skinparam backgroundColor white
title RegulaGraph-ID - Ingestion and Snapshot-Based Queries
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam nodesep 65
skinparam ranksep 80
actor "Operator" as Operator
actor "User" as User
cloud "BPK / JDIH Kemkomdigi / JDIHN\n(connector coverage varies)" as Sources
database "FileStore\nPDFs, text, immutable batches" as Files
database "PostgreSQL\njobs, registry, ledger, snapshot" as PG
database "Qdrant\ndense + sparse BM25" as QD
database "Neo4j\nentity, relation, source support" as Neo
component "Pinned local / provider LLM" as LLM
package "Go - src/server" {
  component "Collector + import" as Collect
  component "Ingestion coordinator\ncheckpoints, BIND, RESOLVE review" as Coord
  component "Semantic gateway\nEXTRACT / RESOLVE proposals" as Semantic
  component "Publication\nadmission, readback, receipts, CAS" as Publish
  component "API / CLI" as API
  component "Query workflow\nnormalize, link, pin snapshot" as Query
  component "Retrieval\nBM25 / dense / graph, filter, RRF" as Retrieve
  component "Answering\nhydrate, context, draft, citations" as Answer
}
package "Rust - src/ingestion" {
  component "Document worker\nPARSE / STRUCTURE / CHUNK" as Document
  component "Semantic validation\nEXTRACT / RESOLVE batches" as Validate
  component "Batch builders\nINDEX / ASSEMBLE" as Builders
}
component "C++ - src/inference\nONNX embedding + reranking\nreusable models, bounded queues" as Native
component "Offline Python\ntooling + evaluation" as Offline
Operator --> Collect
Sources --> Collect
Collect --> Files
Collect --> Coord
Coord <--> PG
Coord --> Document
Document <--> Files
Coord --> Validate
Validate --> Semantic
Semantic --> LLM
Coord --> Builders
Builders --> Native
Builders --> Files
Coord --> Publish
Publish --> QD
Publish --> Neo
Publish --> PG
User --> API
API --> Query
Query --> PG
Query --> Retrieve
Retrieve --> Native
Retrieve --> QD
Retrieve --> Neo
Retrieve --> Answer
Answer --> Files
Answer --> Native
Answer --> LLM
Answer --> API
API --> User
Offline ..> Files
Offline ..> API
note bottom of Query
Profiles are currently selected explicitly.
Adaptive classification and retrieval retries
are planned, not active request paths.
end note
legend bottom
  Component dependencies; data flow and execution order are described in the README tables.
  Go owns workflows and publication; Rust produces batches; C++ runs inference.
  Arrows do not imply an RPC per step. Models and snapshots are pinned across components.
endlegend
@enduml
