' Big-picture ingestion and query flow for README; render to SVG with PlantUML.
' Arrows describe logical data flow; notes distinguish implemented paths from planned automation.
@startuml
title RegulaGraph-ID - Gambaran Besar Sistem
top to bottom direction
skinparam linetype ortho
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName SansSerif
skinparam nodesep 35
skinparam ranksep 35
skinparam rectangleBackgroundColor #F1F5FA
skinparam rectangleBorderColor #375575
skinparam ArrowColor #375575

package "1. Menyiapkan corpus (offline / batch)" {
  rectangle "Regulasi Indonesia\nPDF + metadata sumber resmi" as Sources
  rectangle "Document Processing\nparse, normalisasi, struktur, binding versi" as Process
  rectangle "Structural Chunking\nchunk + konteks induk + span sumber" as Chunk
  rectangle "Entity & Relation Extraction\nLLM + validasi ontology / bukti" as Extract
  rectangle "Entity Resolution\ncanonical identity + review keputusan" as Resolve
  rectangle "Graph Assembly\nfakta tervalidasi + provenance" as Assemble
  rectangle "Index Building\nBM25 + dense embeddings" as Index
  rectangle "Publication\nverifikasi output + aktifkan snapshot konsisten" as Publish
  database "Qdrant\nindeks lexical + vector" as Qdrant
  database "Neo4j\nknowledge graph + dukungan sumber" as Neo4j
  Sources --> Process
  Process --> Chunk
  Chunk --> Extract
  Chunk --> Index
  Extract --> Resolve
  Resolve --> Assemble
  Assemble --> Publish
  Index --> Publish
  Publish --> Qdrant
  Publish --> Neo4j
}

package "2. Menjawab pertanyaan (online)" {
  rectangle "User Question\npertanyaan + scope / tanggal" as Question
  rectangle "Query Preparation\nnormalisasi + entity linking + pin snapshot" as Prepare
  rectangle "Retrieval Routing\nprofil eksplisit saat ini" as Route
  rectangle "BM25 Retrieval" as BM25
  rectangle "Dense Retrieval" as Dense
  rectangle "Graph Retrieval" as Graph
  rectangle "Filter + Retrieval Fusion\nversi / scope, dedup, RRF" as Fusion
  rectangle "Hydrate + Reranker\nambil teks sumber; reranking opsional" as Rerank
  rectangle "Context Builder\nevidence + parent context + token budget" as Context
  rectangle "LLM Generation" as Generate
  rectangle "Validate Evidence & Citations\nperiksa referensi dan dukungan yang tersedia" as Validate
  rectangle "Draft Answer / Partial / Abstain\ncitations + evidence + graph paths jika tersedia" as Answer
  Question --> Prepare
  Prepare --> Route
  Route --> BM25
  Route --> Dense
  Route --> Graph
  BM25 --> Fusion
  Dense --> Fusion
  Graph --> Fusion
  Fusion --> Rerank
  Rerank --> Context
  Context --> Generate
  Generate --> Validate
  Validate --> Answer
  note right of Route
    Rencana lanjutan:
    klasifikasi query adaptif dan
    retrieve-again otomatis.
    Cabang aktif mengikuti profil.
  end note
}

Qdrant -[hidden]down-> Question
Neo4j -[hidden]down-> Question
legend bottom
  Retrieval membaca indeks dan graph pada snapshot terpublikasi yang sama.
  Workflow Go mengatur urutan; Rust memproses batch; C++ menjalankan embedding/reranking.
  Diagram menunjukkan arsitektur; acceptance kualitas dan performa belum dinyatakan lulus.
endlegend
@enduml
