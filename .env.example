# Contoh nama konfigurasi lingkungan, bukan kredensial atau koneksi aktif.
# Peran: input konfigurasi bagi loader Go dan dependency wiring ketika tersedia.
# Integrasi: jangan commit .env; nilai kosong wajib ditangani loader secara eksplisit.
# Performa: model, endpoint, dan resource perlu dicatat dalam eksperimen tanpa rahasia.
REGULAGRAPH_ENV=development
REGULAGRAPH_DATA_DIR=./data
REGULAGRAPH_ARTIFACTS_DIR=./artifacts
REGULAGRAPH_POSTGRES_DSN=
REGULAGRAPH_QDRANT_URL=
REGULAGRAPH_NEO4J_URI=
REGULAGRAPH_NEO4J_USER=
REGULAGRAPH_NEO4J_PASSWORD=
REGULAGRAPH_LLM_PROVIDER=
REGULAGRAPH_LLM_API_KEY=

# Worker PARSE dan coordinator Go memakai boundary loopback sampai TLS deployment tersedia.
REGULAGRAPH_WORKER_ENDPOINT=127.0.0.1:50051
REGULAGRAPH_WORKER_LISTEN=127.0.0.1:50051
REGULAGRAPH_WORKER_ARTIFACT_ROOT=./artifacts
REGULAGRAPH_WORKER_PDFIUM_LIBRARY=
REGULAGRAPH_WORKER_PDFIUM_SHA256=
REGULAGRAPH_WORKER_PDFIUM_VERSION=
# Pinned Hugging Face tokenizer.json used by CHUNK; its SHA-256 becomes the tokenizer identity.
REGULAGRAPH_WORKER_TOKENIZER_JSON=
REGULAGRAPH_WORKER_TOKENIZER_SHA256=
REGULAGRAPH_WORKER_MAX_MESSAGE_BYTES=16777216
REGULAGRAPH_WORKER_MAX_ARTIFACT_BYTES=536870912
REGULAGRAPH_WORKER_MAX_CONCURRENT_BATCHES=2
REGULAGRAPH_WORKER_MAX_JOBS=10000
# Optional EXTRACT runtime. If endpoint is set, every identity/path below becomes required.
# All three runtimes pin the same exact ontology bytes; update this hash when the vocabulary changes.
REGULAGRAPH_ONTOLOGY_PATH=./configs/ontology-v1.jsonc
REGULAGRAPH_ONTOLOGY_SHA256=d4f48615c3d85416a7a343d0d604b237afa66c36725187268eeb17819e7ed0fb
REGULAGRAPH_WORKER_SEMANTIC_ENDPOINT=127.0.0.1:50052
REGULAGRAPH_WORKER_EXTRACTION_OUTPUT_SCHEMA=./src/contracts/jsonschema/extraction-output-v1.json
REGULAGRAPH_WORKER_EXTRACTION_PROMPT_SHA256=f7dcb6105c26ce59464745c70c17a8c1f482c248d1c2b0997758ee032ff0ef4c
REGULAGRAPH_WORKER_EXTRACTION_MODEL_ID=
REGULAGRAPH_WORKER_EXTRACTION_MODEL_VERSION=
REGULAGRAPH_WORKER_EXTRACTION_WEIGHTS_SHA256=
REGULAGRAPH_WORKER_EXTRACTION_TOKENIZER_SHA256=
REGULAGRAPH_WORKER_EXTRACTION_MAX_TOKENS=8192
REGULAGRAPH_WORKER_EXTRACTION_PRECISION=
REGULAGRAPH_WORKER_EXTRACTION_BACKEND=
REGULAGRAPH_WORKER_EXTRACTION_ONTOLOGY_VERSION=id-regulation-ontology-v1
REGULAGRAPH_WORKER_EXTRACTION_MAX_ITEMS_PER_RPC=256
REGULAGRAPH_WORKER_EXTRACTION_MAX_INPUT_BYTES_PER_RPC=4194304
# Go Semantic Gateway: listener internal dan provider structured-output OpenAI-compatible.
# API key boleh kosong untuk provider lokal; endpoint non-loopback wajib HTTPS.
REGULAGRAPH_SEMANTIC_TASK=EXTRACT
REGULAGRAPH_SEMANTIC_LISTEN=127.0.0.1:50052
REGULAGRAPH_SEMANTIC_PROVIDER_ENDPOINT=
REGULAGRAPH_SEMANTIC_PROVIDER_API_KEY=
REGULAGRAPH_SEMANTIC_PROMPT_PATH=./configs/prompts/extraction-v1.md
REGULAGRAPH_SEMANTIC_PROVIDER_TIMEOUT=90s
REGULAGRAPH_SEMANTIC_PROVIDER_MAX_RESPONSE_BYTES=4194304
REGULAGRAPH_SEMANTIC_MAX_ITEMS=256
REGULAGRAPH_SEMANTIC_MAX_INPUT_BYTES=4194304
REGULAGRAPH_SEMANTIC_MAX_CONCURRENT=8
REGULAGRAPH_SEMANTIC_CACHE_ENTRIES=4096
REGULAGRAPH_SEMANTIC_CACHE_BYTES=268435456
REGULAGRAPH_SEMANTIC_MAX_MESSAGE_BYTES=16777216
REGULAGRAPH_BUILD_ID=local-dev
# RESOLVE runs as a separate gateway process: set TASK=RESOLVE, listener e.g. 127.0.0.1:50053,
# and SEMANTIC_PROMPT_PATH=./configs/prompts/resolution-v1.md. Choose/pin real local model files.
# PROMPT_SHA256 must match the actual prompt bytes (including line endings); no model is selected here.
REGULAGRAPH_WORKER_RESOLUTION_OUTPUT_SCHEMA=./src/contracts/jsonschema/resolution-output-v1.json
REGULAGRAPH_WORKER_RESOLUTION_PROMPT_SHA256=
REGULAGRAPH_WORKER_RESOLUTION_MODEL_ID=
REGULAGRAPH_WORKER_RESOLUTION_MODEL_VERSION=
REGULAGRAPH_WORKER_RESOLUTION_WEIGHTS_SHA256=
REGULAGRAPH_WORKER_RESOLUTION_TOKENIZER_SHA256=
REGULAGRAPH_WORKER_RESOLUTION_MAX_TOKENS=8192
REGULAGRAPH_WORKER_RESOLUTION_PRECISION=
REGULAGRAPH_WORKER_RESOLUTION_BACKEND=
REGULAGRAPH_WORKER_RESOLUTION_ONTOLOGY_VERSION=id-regulation-ontology-v1
REGULAGRAPH_CORPUS_JURISDICTION=ID
REGULAGRAPH_BIND_MAX_BATCH_BYTES=536870912
REGULAGRAPH_BIND_MAX_RECORDS=100000
REGULAGRAPH_BIND_REGISTRY_BATCH_SIZE=10000
REGULAGRAPH_COORDINATOR_OWNER=coordinator-local-1
REGULAGRAPH_COORDINATOR_AUTH_SCOPE=ingestion-local
REGULAGRAPH_COORDINATOR_LEASE=5m
REGULAGRAPH_COORDINATOR_CALL_TIMEOUT=4m
REGULAGRAPH_COORDINATOR_CANCELLATION_POLL=250ms
REGULAGRAPH_COORDINATOR_IDLE_POLL=500ms
REGULAGRAPH_COORDINATOR_RETRY_BASE=1s
REGULAGRAPH_COORDINATOR_RETRY_MAX=1m

# Runtime tensor C++ untuk embedding/reranking tetap belum aktif.
REGULAGRAPH_INFERENCE_ENDPOINT=
