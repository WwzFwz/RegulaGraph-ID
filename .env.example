# Contoh nama konfigurasi lingkungan, bukan kredensial atau koneksi aktif.
# Peran: input konfigurasi bagi loader Go dan dependency wiring ketika tersedia.
# Integrasi: jangan commit .env; nilai kosong wajib ditangani loader secara eksplisit.
# Performa: model, endpoint, dan resource perlu dicatat dalam eksperimen tanpa rahasia.
REGULAGRAPH_ENV=development
REGULAGRAPH_DATA_DIR=./data
REGULAGRAPH_ARTIFACTS_DIR=./artifacts
REGULAGRAPH_POSTGRES_DSN=
REGULAGRAPH_QDRANT_URL=
REGULAGRAPH_NEO4J_URI=
REGULAGRAPH_NEO4J_USER=
REGULAGRAPH_NEO4J_PASSWORD=
REGULAGRAPH_LLM_PROVIDER=
REGULAGRAPH_LLM_API_KEY=

# Endpoint worker/inference belum aktif; nilai berikut baru deklarasi konfigurasi.
REGULAGRAPH_WORKER_ENDPOINT=
REGULAGRAPH_INFERENCE_ENDPOINT=
